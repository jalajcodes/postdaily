{
  "name": "@postdaily/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/node.ts",
    "start": "tsx --env-file-if-exists=../../.env src/node.ts",
    "typecheck": "tsc -p .",
    "cf:dev": "npm run build -w @postdaily/web && wrangler d1 migrations apply postdaily --local && wrangler dev --test-scheduled",
    "cf:migrate": "wrangler d1 migrations apply postdaily --remote",
    "cf:deploy": "npm run build -w @postdaily/web && wrangler d1 migrations apply postdaily --remote && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.21",
    "luxon": "^3.7.2",
    "openai": "^7.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
