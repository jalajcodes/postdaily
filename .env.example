# ---- Server ----
API_PORT=8787
# Where the web app runs (used for OAuth redirects back to the UI)
WEB_URL=http://localhost:5173
# Public URL of this API (LinkedIn redirect URI = API_URL/api/auth/linkedin/callback)
API_URL=http://localhost:8787
DATABASE_PATH=./data/postdaily.db
# Allow "Continue without LinkedIn" local login (handy before you set up the LinkedIn app)
ALLOW_DEV_LOGIN=true
# macOS notification when you haven't posted by your reminder time
MAC_NOTIFICATIONS=true

# ---- LinkedIn (https://www.linkedin.com/developers/apps) ----
# Add products: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Monthly API version (YYYYMM). LinkedIn retires versions after ~1 year.
LINKEDIN_API_VERSION=202606

# ---- AI providers (pick one in Settings; you can switch any time) ----
# 1) "Claude (my Claude login)" uses your local Claude Code login - no key needed.
#    Run `claude` once and sign in if you haven't.
# 2) Anthropic API key
ANTHROPIC_API_KEY=
# 3) OpenRouter - free models available (key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# 4) OpenAI
OPENAI_API_KEY=
# 5) Ollama (local models)
OLLAMA_URL=http://localhost:11434
